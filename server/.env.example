# PostgreSQL (nunca versionar a senha real)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/mezzo_escola?schema=public"

# API
PORT=3333
NODE_ENV="development"
WEB_ORIGIN="http://localhost:5173"

# Autenticação — gerar valores longos, aleatórios e exclusivos por ambiente
JWT_ACCESS_SECRET="substitua-por-um-segredo-seguro-com-no-minimo-32-caracteres"
JWT_REFRESH_SECRET="substitua-por-outro-segredo-seguro-com-no-minimo-32-caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
